rules_version = '2';

// Security model
// - Anything touching money, roles, store identity, products, fulfilment or payouts is written
//   ONLY by the server (Admin SDK in src/app/api/**), which bypasses these rules.
// - Clients may write: their own profile (safe fields), and admins may write categories.
// - Reads are scoped to owners / admins; the public sees active catalog data only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      // created by /api/auth/bootstrap; users may edit safe profile fields only
      allow update: if signedIn() && uid() == userId
        && changes().hasOnly(['displayName', 'phone'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20));
      allow create, delete: if false;
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if false; // /api/merchant/apply, /api/merchant/profile, /api/admin/merchants/[id]

      // Bank details: owner + admin may read; writes via /api/merchant/bank (audited)
      match /private/{docId} {
        allow read: if signedIn() && (uid() == merchantId || isAdmin());
        allow write: if false;
      }
    }

    match /slugs/{slug} {
      allow read, write: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.order is number;
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && (resource.data.merchantId == uid() || isAdmin()));
      allow write: if false; // /api/merchant/products
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.customerId == uid() || isAdmin());
      allow write: if false;
    }

    match /merchantOrders/{id} {
      // merchant sees their rows, the customer sees their own (tracking), admin sees all
      allow read: if signedIn()
        && (resource.data.merchantId == uid() || resource.data.customerId == uid() || isAdmin());
      allow write: if false; // /api/merchant/orders/[id]/fulfillment
    }

    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.merchantId == uid() || isAdmin());
      allow write: if false;
    }

    // Refund clawbacks deducted from a store's next payout
    match /ledgerAdjustments/{id} {
      allow read: if signedIn() && (resource.data.merchantId == uid() || isAdmin());
      allow write: if false; // written by refunds, applied by /api/admin/payouts
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if false; // /api/admin/settings
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paymentEvents/{id} {
      allow read, write: if false;
    }
  }
}
